<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doğanın Teknolojisi — Polinasyon</title>
  <meta name="description" content="Doğa araştırmaları, biyo-teknoloji ve arı kolonisi simülasyonları ile modern yazılım mimarilerinin buluştuğu dijital platform." />
  <meta name="robots" content="index, follow" />

  <style>
    :root {
      --bg: #0b0f0d;
      --surface: #151a17;
      --surface-2: #1c231f;
      --text: #e6ebe8;
      --muted: #8b9a91;
      --accent: #c9a227;
      --border: rgba(255, 255, 255, 0.06);
      --radius: 12px;
      --shadow: 0 4px 20px -6px rgba(0, 0, 0, 0.45);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(11, 15, 13, 0.94);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 62px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-weight: 700;
      font-size: 1.12rem;
      color: var(--text);
      text-decoration: none;
      letter-spacing: 0.2px;
    }

    .logo svg {
      width: 24px;
      height: 24px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    .icon-btn:hover {
      background: var(--surface-2);
      border-color: rgba(201, 162, 39, 0.3);
      color: var(--accent);
    }

    .icon-btn svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Dropdown */
    .dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      width: 210px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.4rem;
      box-shadow: var(--shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
      z-index: 200;
    }

    .dropdown.open .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .dropdown-item {
      display: block;
      padding: 0.65rem 0.85rem;
      color: var(--text);
      text-decoration: none;
      font-size: 0.93rem;
      border-radius: 8px;
      transition: background 0.15s, color 0.15s;
    }

    .dropdown-item:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .dropdown-item.astro {
      color: var(--accent);
    }

    /* Search */
    .search-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.28s ease;
      background: var(--surface);
      border-bottom: 1px solid transparent;
    }

    .search-panel.active {
      max-height: 68px;
      border-bottom-color: var(--border);
    }

    .search-panel-inner {
      padding: 0.75rem 0;
    }

    .search-input {
      width: 100%;
      padding: 0.65rem 0.95rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.93rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-input:focus {
      border-color: rgba(201, 162, 39, 0.45);
    }

    /* Sections */
    section {
      padding: 3.25rem 0;
    }

    .section-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 1.35rem;
      letter-spacing: -0.2px;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 5.25rem 0 3.75rem;
    }

    .hero h1 {
      font-size: clamp(1.9rem, 4.8vw, 2.6rem);
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 0.7rem;
      letter-spacing: -0.4px;
    }

    .hero .subtitle {
      font-size: 1.1rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 0.95rem;
    }

    .hero .desc {
      max-width: 480px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 1.02rem;
    }

    /* Cards */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.1rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem;
      box-shadow: var(--shadow);
      transition: border-color 0.2s, transform 0.2s;
    }

    .card:hover {
      border-color: rgba(201, 162, 39, 0.28);
      transform: translateY(-2px);
    }

    .card h3 {
      color: var(--accent);
      font-size: 1.05rem;
      margin-bottom: 0.45rem;
      font-weight: 650;
    }

    .card p {
      color: var(--muted);
      font-size: 0.93rem;
    }

    /* Stats */
    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      text-align: center;
    }

    .stat-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem 1rem;
      box-shadow: var(--shadow);
    }

    .stat-num {
      font-size: 2.35rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.5px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 0.88rem;
      margin-top: 0.3rem;
    }

    /* Badges */
    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .badge {
      padding: 0.38rem 0.85rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.83rem;
      color: var(--text);
      transition: border-color 0.2s, color 0.2s;
    }

    .badge:hover {
      border-color: rgba(201, 162, 39, 0.35);
      color: var(--accent);
    }

    /* Blog - alıntı tarzı sol çizgi */
    .blog-item {
      position: relative;
      padding: 1.15rem 0 1.15rem 1.1rem;
      border-bottom: 1px solid var(--border);
    }

    .blog-item:last-child {
      border-bottom: none;
    }

    .blog-item::before {
      content: "";
      position: absolute;
      left: 0;
      top: 1.15rem;
      bottom: 1.15rem;
      width: 3px;
      background: var(--accent);
      border-radius: 2px;
      opacity: 0.7;
    }

    .blog-item h3 {
      font-size: 1.1rem;
      margin-bottom: 0.25rem;
      transition: color 0.2s;
    }

    .blog-item h3:hover {
      color: var(--accent);
    }

    .blog-meta {
      font-size: 0.83rem;
      color: var(--muted);
      margin-bottom: 0.35rem;
    }

    .blog-item p {
      color: var(--muted);
      font-size: 0.93rem;
    }

    /* Footer */
    footer {
      padding: 2.75rem 0;
      border-top: 1px solid var(--border);
      text-align: center;
    }

    .footer-brand {
      font-weight: 600;
      margin-bottom: 1.1rem;
      letter-spacing: 0.3px;
    }

    .socials {
      display: flex;
      justify-content: center;
      gap: 1.1rem;
      margin-bottom: 1.1rem;
    }

    .socials a {
      color: var(--muted);
      transition: color 0.2s;
    }

    .socials a:hover {
      color: var(--accent);
    }

    .socials svg {
      width: 19px;
      height: 19px;
      fill: currentColor;
    }

    .copy {
      font-size: 0.83rem;
      color: var(--muted);
    }

    /* Back to top */
    .back-top {
      position: fixed;
      bottom: 1.4rem;
      right: 1.4rem;
      width: 40px;
      height: 40px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 50%;
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 0.22s, transform 0.22s, visibility 0.22s, background 0.2s;
      z-index: 90;
      box-shadow: var(--shadow);
    }

    .back-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-top:hover {
      background: var(--accent);
      color: #0b0f0d;
      border-color: var(--accent);
    }

    .back-top svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      stroke-width: 2.5;
      fill: none;
    }

    @media (max-width: 640px) {
      .stats {
        grid-template-columns: 1fr;
        gap: 1.1rem;
      }
      .hero {
        padding: 4.25rem 0 3rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="container">
      <div class="header-inner">
        <div class="dropdown" id="dropdown">
          <button class="icon-btn" id="menuBtn" aria-label="Menü">
            <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div class="dropdown-menu">
            <a href="#top" class="dropdown-item">Ana Sayfa</a>
            <a href="#urunler" class="dropdown-item">Ürünler</a>
            <a href="#blog" class="dropdown-item">Blog</a>
            <a href="#hakkimizda" class="dropdown-item">Hakkımda</a>
            <a href="#iletisim" class="dropdown-item">İletişim</a>
            <a href="#" class="dropdown-item astro">Astro Şablonu</a>
          </div>
        </div>

        <a href="#top" class="logo">
          <svg viewBox="0 0 48 48" fill="none">
            <path fill="#e6ebe8" d="M5.63 24l4.7-8.14h9.4L24.42 24l-4.7 8.14h-9.4z"/>
            <path fill="#c9a227" d="M23.58 13.64L28.27 5.5h9.4l4.7 8.14-4.7 8.14h-9.4z"/>
            <path fill="#c9a227" d="M23.58 34.36l4.7-8.14h9.4l4.7 8.14-4.7 8.14h-9.4z"/>
          </svg>
          Polinasyon
        </a>

        <button class="icon-btn" id="searchBtn" aria-label="Arama">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
    </div>

    <div class="search-panel" id="searchPanel">
      <div class="container">
        <div class="search-panel-inner">
          <input type="text" class="search-input" id="searchInput" placeholder="Site içi arama..." />
        </div>
      </div>
    </div>
  </header>

  <main>
    <div class="container">

      <section class="hero" id="top">
        <h1>Doğanın Teknolojisi</h1>
        <p class="subtitle">Kanatların Matematiği & Yazılım</p>
        <p class="desc">Doğa araştırmacısı ve web geliştiricisiyim. Ekosistemlerin geleceğini kodluyor, arıların izinde dijital çözümler üretiyorum.</p>
      </section>

      <section id="urunler">
        <h2 class="section-title">Öne Çıkan Ürünler & Projeler</h2>
        <div class="grid">
          <div class="card">
            <h3>BeeTrack — Kovan Takip</h3>
            <p>IoT tabanlı, arı kovanlarının sıcaklık ve nem dengesini anlık izleyen mobil uygulama.</p>
          </div>
          <div class="card">
            <h3>PolenAtlas</h3>
            <p>Yapay zeka ile bitki türlerini ve polen yayılım haritalarını çıkaran web platformu.</p>
          </div>
          <div class="card">
            <h3>EkoSimülatör</h3>
            <p>Arı popülasyonunun tarımsal üretime etkisini simüle eden interaktif analiz aracı.</p>
          </div>
        </div>
      </section>

      <section>
        <div class="stats">
          <div class="stat-box">
            <div class="stat-num">142.840+</div>
            <div class="stat-label">Simüle Edilen Arı Popülasyonu</div>
          </div>
          <div class="stat-box">
            <div class="stat-num">12</div>
            <div class="stat-label">Tamamlanan Çevre Projesi</div>
          </div>
        </div>
      </section>

      <section id="hakkimizda">
        <h2 class="section-title">Hakkımda</h2>
        <p style="color: var(--muted); max-width: 580px;">
          Doğadaki kusursuz geometriden ve arıların koloni zekâsından ilham alarak modern yazılım mimarileri geliştiriyorum. Hedefim; teknoloji ile biyoçeşitliliği buluşturan, sürdürülebilir sistemler inşa etmek.
        </p>
      </section>

      <section>
        <h2 class="section-title">Kullanılan Teknolojiler</h2>
        <div class="badges">
          <span class="badge">Astro</span>
          <span class="badge">HTML5</span>
          <span class="badge">CSS3</span>
          <span class="badge">JavaScript</span>
          <span class="badge">Git</span>
          <span class="badge">Yapay Zeka</span>
        </div>
      </section>

      <section id="blog">
        <h2 class="section-title">Son Blog Yazıları</h2>
        <div class="blog-item">
          <h3>Arıların Gizli Mühendisliği</h3>
          <div class="blog-meta">10 Eylül 2026 · 3 dk okuma</div>
          <p>Tek bir bal arısının tüm koloniyi ayakta tutan matematiksel veri akışını nasıl yönettiğini inceliyoruz.</p>
        </div>
        <div class="blog-item">
          <h3>Neden Astro Framework?</h3>
          <div class="blog-meta">28 Ağustos 2026 · 5 dk okuma</div>
          <p>İçerik odaklı doğa projelerinde neden en hızlı ve en hafif framework olan Astro’yu tercih ettim?</p>
        </div>
      </section>

    </div>
  </main>

  <footer id="iletisim">
    <div class="container">
      <div class="footer-brand">Polinasyon</div>
      <div class="socials">
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85s.01-3.58.07-4.85c.15-3.23 1.66-4.77 4.92-4.92 1.27-.06 1.65-.07 4.85-.07zm0-2.16c-3.26 0-3.67.01-4.95.07-4.36.2-6.78 2.62-6.98 6.98-.06 1.28-.07 1.69-.07 4.95s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.36-2.62-6.78-6.98-6.98-1.28-.06-1.7-.07-4.95-.07zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zm0 10.16a4 4 0 110-8 4 4 0 010 8zm6.41-11.85a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg></a>
        <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 002.12 2.14c1.87.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg></a>
        <a href="#" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24H16.17l-5.21-6.82L4.99 21.75H1.68l7.73-8.84L1.25 2.25H8.08l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/></svg></a>
      </div>
      <div class="copy">© 2026 Polinasyon. Tüm hakları saklıdır.</div>
    </div>
  </footer>

  <button class="back-top" id="backTop" aria-label="Yukarı">
    <svg viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <script>
    const dropdown = document.getElementById('dropdown');
    const menuBtn = document.getElementById('menuBtn');
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('open');
    });
    document.addEventListener('click', () => dropdown.classList.remove('open'));

    const searchBtn = document.getElementById('searchBtn');
    const searchPanel = document.getElementById('searchPanel');
    const searchInput = document.getElementById('searchInput');
    searchBtn.addEventListener('click', () => {
      searchPanel.classList.toggle('active');
      if (searchPanel.classList.contains('active')) {
        setTimeout(() => searchInput.focus(), 40);
      }
    });

    const backTop = document.getElementById('backTop');
    window.addEventListener('scroll', () => {
      backTop.classList.toggle('visible', window.scrollY > 280);
    });
    backTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</body>
</html>
