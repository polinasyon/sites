					<p class="text-sm text-[#94a3b8]">Arı popülasyonunun tarımsal üretime etkisini simüle eden interaktif analiz aracı.</p>
				</div>
			</div>
		</section>

		<!-- Sayaçlar -->
		<section class="p-6 md:p-8 rounded-2xl bg-gradient-to-b from-[#1c1c1c]/40 to-[#141414]/60 border border-white/5 shadow-xl">
