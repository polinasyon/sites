<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Doğanın Teknolojisi: Polinasyon & Yazılım</title>
	<style>
		/* Renk Paleti ve Değişkenler */
		:root {
			--bg-black: #0d0d0d;         /* Tam Mat Siyah Zemin */
			--bg-surface: #1c1c1c;       /* Mat Koyu Gri Yüzey */
			--text-main: #e2e8f0;        /* Platin / Mat Açık Gri */
			--text-muted: #94a3b8;       /* Mat Dumanlı Gri */
			--border-subtle: rgba(255, 255, 255, 0.08);
			--surface-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 10px 30px -10px rgba(0, 0, 0, 0.8);
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			background-color: var(--bg-black);
			color: var(--text-main);
			font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			line-height: 1.6;
		}

		.container {
			max-width: 1000px;
			margin: 0 auto;
			padding: 0 1.5rem;
		}

		/* Header & Arama Kutusu */
		header {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			background: rgba(13, 13, 13, 0.85);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--border-subtle);
			z-index: 1000;
		}

		.header-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			height: 70px;
		}

		.logo {
			font-size: 1.35rem;
			font-weight: 700;
			color: var(--text-main);
			text-decoration: none;
			letter-spacing: 0.5px;
		}

		.search-btn {
			background: transparent;
			border: none;
			color: var(--text-muted);
			cursor: pointer;
			padding: 0.5rem;
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: all 0.3s ease;
		}

		.search-btn:hover {
			color: var(--text-main);
			background: rgba(255, 255, 255, 0.05);
		}

		.search-btn svg {
			width: 22px;
			height: 22px;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		/* Aşağı Açılan Arama Paneli */
		.search-panel {
			max-height: 0;
			overflow: hidden;
			background: var(--bg-surface);
			border-bottom: 0px solid var(--border-subtle);
			transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), padding 0.3s ease;
		}

		.search-panel.active {
			max-height: 100px;
			border-bottom: 1px solid var(--border-subtle);
		}

		.search-panel-inner {
			padding: 1rem 0 1.5rem 0;
			display: flex;
			gap: 0.75rem;
		}

		.search-input {
			width: 100%;
			padding: 0.75rem 1rem;
			background: var(--bg-black);
			border: 1px solid var(--border-subtle);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			outline: none;
			transition: border-color 0.3s ease;
		}

		.search-input:focus {
			border-color: rgba(255, 255, 255, 0.3);
		}

		/* Bölüm Derinlik Ayarları */
		section {
			padding: 4rem 2rem;
			margin-bottom: 2.5rem;
			background: linear-gradient(180deg, rgba(28, 28, 28, 0.4) 0%, rgba(20, 20, 20, 0.6) 100%);
			border-top: 1px solid var(--border-subtle);
			border-radius: 16px;
			box-shadow: var(--surface-shadow);
		}

		h2 {
			color: var(--text-main);
			font-size: 1.75rem;
			margin-bottom: 1.5rem;
			font-weight: 700;
		}

		/* Hero Alanı */
		.hero {
			text-align: center;
			padding-top: 5rem;
			padding-bottom: 4rem;
			margin-top: 6rem;
			background: linear-gradient(180deg, rgba(28, 28, 28, 0.6) 0%, rgba(13, 13, 13, 0.2) 100%);
		}

		h1 {
			font-size: 2.75rem;
			line-height: 1.2;
			margin-bottom: 1rem;
			color: var(--text-main);
			font-weight: 800;
		}

		.subtitle {
			font-size: 1.2rem;
			color: var(--text-main);
			margin-bottom: 1.25rem;
		}

		.description {
			max-width: 600px;
			margin: 0 auto;
			color: var(--text-muted);
		}

		/* Proje Kartları Grid */
		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.card {
			background: var(--bg-surface);
			border: 1px solid var(--border-subtle);
			padding: 1.75rem;
			border-radius: 12px;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
			transition: all 0.3s ease;
		}

		.card:hover {
			transform: translateY(-4px);
			border-color: rgba(255, 255, 255, 0.15);
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
		}

		.card h3 {
			color: var(--text-main);
			margin-bottom: 0.75rem;
		}

		.card p {
			color: var(--text-muted);
			font-size: 0.95rem;
		}

		/* Sayaçlar */
		.stats-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			text-align: center;
			gap: 2rem;
		}

		.stat-number {
			font-size: 3rem;
			font-weight: 800;
			color: var(--text-main);
			margin-bottom: 0.25rem;
		}

		.stat-label {
			color: var(--text-muted);
			font-size: 0.95rem;
		}

		/* Rozetler */
		.badges {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
		}

		.badge {
			background: var(--bg-surface);
			border: 1px solid var(--border-subtle);
			padding: 0.4rem 0.9rem;
			border-radius: 20px;
			font-size: 0.85rem;
			color: var(--text-main);
			transition: all 0.3s ease;
		}

		.badge:hover {
			border-color: rgba(255, 255, 255, 0.2);
			background: rgba(255, 255, 255, 0.05);
		}

		/* Blog */
		.blog-item {
			margin-bottom: 2rem;
		}

		.blog-item:last-child {
			margin-bottom: 0;
		}

		.blog-item h3 {
			color: var(--text-main);
			margin-bottom: 0.4rem;
			transition: opacity 0.3s ease;
			cursor: pointer;
		}

		.blog-item h3:hover {
			opacity: 0.8;
		}

		.blog-meta {
			color: var(--text-muted);
			font-size: 0.85rem;
			margin-bottom: 0.5rem;
		}

		.blog-item p {
			color: var(--text-muted);
		}

		/* Footer Stil Tanımlaması */
		footer {
			margin-top: 4rem;
			padding: 3rem 0;
			border-top: 1px solid var(--border-subtle);
			background: var(--bg-black);
		}

		.footer-content {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.5rem;
			text-align: center;
		}

		.footer-brand {
			font-size: 1.1rem;
			font-weight: 600;
			color: var(--text-main);
			letter-spacing: 0.5px;
		}

		.social-links {
			display: flex;
			gap: 1.25rem;
			align-items: center;
		}

		.social-icon {
			color: var(--text-muted);
			transition: all 0.3s ease;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.social-icon svg {
			width: 24px;
			height: 24px;
			fill: currentColor;
		}

		.social-icon:hover {
			color: var(--text-main);
			transform: translateY(-2px);
		}

		.footer-copy {
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		/* Mobile / Responsive Breakpoints */
		@media (max-width: 768px) {
			section {
				padding: 2.5rem 1.25rem;
				margin-bottom: 1.5rem;
				border-radius: 12px;
			}

			.hero {
				padding-top: 3rem;
				margin-top: 5rem;
			}

			h1 {
				font-size: 2.1rem;
			}

			.subtitle {
				font-size: 1.05rem;
			}

			.stats-grid {
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}

			.stat-number {
				font-size: 2.5rem;
			}
		}
	</style>
</head>
<body>

	<!-- Header -->
	<header>
		<div class="container">
			<div class="header-inner">
				<a href="#" class="logo">Polinasyon</a>
				<button class="search-btn" id="searchToggle" aria-label="Arama Yap">
					<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				</button>
			</div>
		</div>
		<!-- Tıklayınca Açılan Arama Paneli -->
		<div class="search-panel" id="searchPanel">
			<div class="container">
				<div class="search-panel-inner">
					<input type="text" class="search-input" id="searchInput" placeholder="Site içi arama yapın..." />
				</div>
			</div>
		</div>
	</header>

	<div class="container">
		<!-- Hero Bölümü -->
		<section class="hero">
			<h1>Doğanın Teknolojisi:<br/>Polinasyon & Yazılım</h1>
			<p class="subtitle">Ekosistemlerin geleceğini kodluyor, arıların izinde dijital çözümler üretiyorum.</p>
			<p class="description">Ben bir doğa araştırmacısı ve web geliştiricisiyim. Biyoçeşitliliğin korunması için teknolojinin gücünü kullanıyor, sürdürülebilir bir gelecek inşa ediyorum.</p>
		</section>

		<!-- Projeler -->
		<section>
			<h2>Öne Çıkan Projeler</h2>
			<div class="grid">
				<div class="card">
					<h3>BeeTrack - Kovan Takip</h3>
					<p>Nesnelerin İnterneti (IoT) tabanlı, arı kovanlarının sıcaklık ve nem dengesini anlık izleyen mobil uygulama.</p>
				</div>
				<div class="card">
					<h3>PolenAtlas</h3>
					<p>Yapay zeka algoritmaları kullanarak bitki türlerini ve polen yayılım haritalarını çıkaran web platformu.</p>
				</div>
				<div class="card">
					<h3>EkoSimülatör</h3>
					<p>Arı popülasyonunun tarımsal üretime etkisini simüle eden interaktif analiz aracı.</p>
				</div>
			</div>
		</section>

		<!-- Sayaçlar -->
		<section class="stats-grid">
			<div>
				<div class="stat-number">142,840+</div>
				<div class="stat-label">Simüle Edilen Arı Popülasyonu</div>
			</div>
			<div>
				<div class="stat-number">12</div>
				<div class="stat-label">Tamamlanan Çevre Projesi</div>
			</div>
		</section>

		<!-- Teknolojiler -->
		<section>
			<h2>Kullanılan Teknolojiler</h2>
			<div class="badges">
				<span class="badge">Astro</span>
				<span class="badge">HTML5</span>
				<span class="badge">CSS3</span>
				<span class="badge">JavaScript</span>
				<span class="badge">Git</span>
				<span class="badge">Yapay Zeka</span>
			</div>
		</section>

		<!-- Blog -->
		<section>
			<h2>Son Blog Yazıları</h2>
			<div class="blog-item">
				<h3>Arıların Gizli Mühendisliği</h3>
				<div class="blog-meta">10 Eylül 2026 • 3 dk okuma</div>
				<p>Tek bir bal arısının tüm koloniyi ayakta tutan matematiksel veri akışını nasıl yönettiğini inceliyoruz.</p>
			</div>
			<div class="blog-item">
				<h3>Neden Astro Framework?</h3>
				<div class="blog-meta">28 Ağustos 2026 • 5 dk okuma</div>
				<p>İçerik odaklı doğa projelerinde neden en hızlı ve en hafif framework olan Astro'yu tercih ettim?</p>
			</div>
		</section>
	</div>

	<!-- Footer -->
	<footer>
		<div class="container">
			<div class="footer-content">
				<div class="footer-brand">Polinasyon</div>
				<div class="social-links">
					<!-- Instagram SVG -->
					<a href="#" class="social-icon" aria-label="Instagram">
						<svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
					<!-- YouTube SVG -->
					<a href="#" class="social-icon" aria-label="YouTube">
						<svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
					</a>
					<!-- Facebook SVG -->
					<a href="#" class="social-icon" aria-label="Facebook">
						<svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
					</a>
				</div>
				<div class="footer-copy">Tüm hakları saklıdır © 2026</div>
			</div>
		</div>
	</footer>

	<!-- Arama Kutusu Açma/Kapatma Scripti -->
	<script>
		const searchToggle = document.getElementById('searchToggle');
		const searchPanel = document.getElementById('searchPanel');
		const searchInput = document.getElementById('searchInput');

		searchToggle.addEventListener('click', () => {
			searchPanel.classList.toggle('active');
			if (searchPanel.classList.contains('active')) {
				setTimeout(() => searchInput.focus(), 100);
			}
		});
	</script>
</body>
</html>
