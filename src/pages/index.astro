			<div class="max-w-4xl mx-auto px-6 py-4">
				<form action="/search" method="GET" class="relative flex items-center w-full">
					<input 
						type="text" 
						name="q" 
						placeholder="Sitede ara (örn: BeeTrack, Astro, Polinasyon)..." 
						class="w-full bg-[#1c1c1c] text-[#e2e8f0] placeholder-[#94a3b8] px-4 py-3 pl-11 rounded-xl border border-white/10 focus:outline-none focus:border-white/30 text-sm"
