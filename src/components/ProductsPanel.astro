---
// Ürünler, Kurucu ve Kalite Güvencesi Manifestosu Modülü
---

<div id="panel-urunler" class="content-panel hidden w-full space-y-6 transition-all duration-300">
	
	<!-- ANA DESTEK GRID YAPISI -->
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		
		<!-- SOL SÜTUN: KURUCU PROFİLİ VE SOSYAL MEDYA -->
		<div class="lg:col-span-1 space-y-6">
			
			<!-- Kurucu Bilgi Kartı -->
			<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center">
				<div class="w-20 h-20 rounded-full bg-red-50 border border-red-100 flex items-center justify-center shadow-inner mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ce2c2c" class="w-10 h-10 animate-bounce">
						<path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3c1.549 0 2.94.612 3.938 1.594l.374.371.374-.371C13.373 3.612 14.762 3 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
					</svg>
				</div>
				<h2 class="text-xl font-black text-gray-900 m-0">Fahri Altıntaş</h2>
				<p class="text-xs font-bold text-amber-600 uppercase tracking-wider m-0 mt-1">Polinasyon Proje Kurucusu</p>
				
				<div class="mt-4 pt-4 border-t border-gray-200/50 w-full text-xs text-gray-500 font-medium space-y-3">
					<p class="m-0 flex items-center justify-center gap-1.5 text-gray-700 font-bold text-sm">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-500 shrink-0">
							<path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
						</svg>
						Simav, Çitgöl
					</p>
					<div class="m-0 leading-relaxed text-gray-600 italic px-1 flex flex-col items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-amber-500">
							<path fill-rule="evenodd" d="M12 2.25c-5.523 0-9.75 4.477-9.75 9.75s4.477 9.75 9.75 9.75 9.75-4.477 9.75-9.75S17.523 2.25 12 2.25zM12 5.25a6.75 6.75 0 100 13.5 6.75 6.75 0 000-13.5zM12 8.25a3.75 3.75 0 100 7.5 3.75 3.75 0 000-7.5zM12 10.5a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" clip-rule="evenodd" />
						</svg>
						<p class="m-0 text-center">"Sadece balın değil, toprağın da kaderini arının kanatlarında taşıyoruz. Teknik uzmanlıkla doğanın en büyük üretim manifestosunu sahada inşa ediyoruz."</p>
					</div>
				</div>
			</div>

			<!-- Sosyal Medya -->
			<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-all duration-300 space-y-3">
				<h3 class="text-sm font-black text-gray-900 uppercase tracking-wider m-0 pb-2 border-b border-gray-200/50">Takip Et</h3>
				<div class="grid grid-cols-3 gap-2 text-center text-xs font-bold">
					<a href="https://facebook.com" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">Facebook</a>
					<a href="https://instagram.com" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">Instagram</a>
					<a href="https://youtube.com" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">YouTube</a>
					<a href="https://twitter.com" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">X / Twitter</a>
					<a href="https://threads.net" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">Threads</a>
					<a href="https://wa.me?" target="_blank" class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-amber-500 hover:text-neutral-950 hover:border-amber-500 no-underline transition-all">WhatsApp</a>
				</div>
			</div>

			<!-- Dijital Katalog -->
			<a href="#" target="_blank" class="block w-full text-center px-6 py-4 bg-neutral-900 text-white font-bold rounded-xl shadow-md hover:bg-amber-500 hover:text-neutral-950 transition-all no-underline tracking-wide text-sm">
				📖 Dijital Kataloğu İncele
			</a>
		</div>

		<!-- SAĞ SÜTUN: ÜRÜNLER -->
		<div class="lg:col-span-2 space-y-6">
			
			<!-- Ürün Kartları -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				
				<!-- Ham Bal -->
				<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center">
					<h3 class="text-base font-black text-gray-900 m-0 flex items-center gap-1.5">🍯 Ham Bal</h3>
					<ul class="m-0 p-0 list-none space-y-1.5 text-sm text-gray-600 font-semibold">
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Antioksidan</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Prebiyotik</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Antimutajenik</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Antiinflamatuar</span></li>
					</ul>
				</div>

				<!-- Polen -->
				<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center">
					<h3 class="text-base font-black text-gray-900 m-0 flex items-center gap-1.5">🐝 Polen</h3>
					<ul class="m-0 p-0 list-none space-y-1.5 text-sm text-gray-600 font-semibold">
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Zengin Proteinler</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Esansiyel Amino Asitler</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Değerli Yağ Asitleri</span></li>
						<li class="flex items-center gap-2 text-neutral-800">✓ <span>Doğal Antioksidan</span></li>
					</ul>
				</div>

				<!-- Propolis -->
				<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center">
					<h3 class="text-base font-black text-gray-900 m-0 flex items-center gap-1.5">🛡️ Propolis</h3>
					<div class="flex flex-wrap gap-1 pt-1">
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Polifenoller</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Terpenoidler</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Steroidler</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Aldehitler</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Kalkonlar</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Ketonlar</span>
						<span class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-2 py-0.5 rounded">Hidrokarbonlar</span>
					</div>
				</div>
			</div>

			<!-- Bilgiyle Ürettik Progress Barları -->
			<div class="bg-gray-50/70 border border-gray-200/50 rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300" space-y-4">
				<h3 class="text-base font-black text-gray-900 uppercase tracking-wider m-0 flex items-center gap-2">
					📊 Bilgiyle Ürettik…
				</h3>
				
				<div class="space-y-3.5 text-sm font-bold text-gray-700">
					<!-- Bal -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-xs">
							<span>Bal Üretim Odağı</span>
							<span class="font-mono bg-white px-1.5 py-0.5 border border-gray-200 rounded">65%</span>
						</div>
						<div class="w-full h-3.5 bg-gray-200/60 rounded-full overflow-hidden border border-gray-200/30 p-0.5">
							<div class="h-full bg-gradient-to-r from-amber-500 to-yellow-400 rounded-full" style="width: 65%"></div>
						</div>
					</div>

					<!-- Polen -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-xs">
							<span>Polen Üretim Odağı</span>
							<span class="font-mono bg-white px-1.5 py-0.5 border border-gray-200 rounded">80%</span>
						</div>
						<div class="w-full h-3.5 bg-gray-200/60 rounded-full overflow-hidden border border-gray-200/30 p-0.5">
							<div class="h-full bg-gradient-to-r from-amber-500 to-yellow-400 rounded-full" style="width: 80%"></div>
						</div>
					</div>

					<!-- Propolis -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-xs">
							<span>Propolis Hasat Yoğunluğu</span>
							<span class="font-mono bg-white px-1.5 py-0.5 border border-gray-200 rounded">40%</span>
						</div>
						<div class="w-full h-3.5 bg-gray-200/60 rounded-full overflow-hidden border border-gray-200/30 p-0.5">
							<div class="h-full bg-gradient-to-r from-amber-500 to-yellow-400 rounded-full" style="width: 40%"></div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>
