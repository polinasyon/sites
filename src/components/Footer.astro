---
const today = new Date();
---

<!-- bg-white ve border-t ile tamamen Header'ın renk ve çizgi dilinde, tam merkezde -->
<footer class="w-full bg-white border-t border-gray-100 py-6 mt-16 text-center relative z-50 pointer-events-auto">
	<!-- max-w-4xl ile iç genişlik korundu, text-center ile her şey tam ortalandı -->
	<div class="max-w-4xl mx-auto px-6 flex flex-col items-center justify-center text-center w-full space-y-1">
		
		<!-- 1. Satır: Telif Hakkı ve Marka -->
		<p class="text-sm font-black text-gray-900 m-0">
			&copy; {today.getFullYear()} PoliNASYON. Tüm hakları saklıdır.
		</p>
		
		<!-- 2. Satır: Alt Başlık ve Manifesto -->
		<p class="text-xs text-gray-500 font-semibold m-0 tracking-wide">
			Simav & Çitgöl Arıcılık Geliştirme ve Ar-Ge Ekosistemi.
		</p>

	</div>
</footer>
